# ── dependencies & build output ──
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ── APK is reproducible via `npm run apk` ──
*.apk

# ── Android: keep the project + gradle fixes, drop build artifacts ──
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/build/
android/app/src/main/assets/public/
android/.idea/
android/local.properties
android/captures/
android/*.iml

# ── iOS (generated by `npx cap add ios`) ──
ios/App/Pods/
ios/App/build/
ios/DerivedData/

# ── misc ──
*.log
.DS_Store
.env*

# ── recovery artifacts: keep the distilled .md docs, drop the heavy extracts ──
recovered/apk-extracted/
recovered/beautified/
recovered/*.txt
