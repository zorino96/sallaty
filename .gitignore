# ── dependencies & build output ──
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ── APK is reproducible via `npm run apk` ──
*.apk

# ── Android: keep the project + gradle fixes, drop build artifacts ──
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/build/
android/app/src/main/assets/public/
android/.idea/
android/local.properties
android/captures/
android/*.iml

# ── iOS (generated by `npx cap add ios`) ──
ios/App/Pods/
ios/App/build/
ios/DerivedData/
# Synced web build — `npx cap sync ios` regenerates it, including on CI.
ios/App/App/public/

# ── shippable binaries: rebuild them, don't version them ──
*.aab
*.apk
*.ipa

# ── generated store artwork: `npm run` regenerates it from the SVGs ──
store/min/
store/*.png
store/ios/*.png

# ── release signing: NEVER commit the key or its passwords ──
*.jks
*.keystore
android/keystore.properties
# Apple signing material, if it ever lands here
*.p8
*.p12
*.pem
*.mobileprovision
*.cer

# ── misc ──
*.log
.DS_Store
.env*

# ── recovery artifacts: keep the distilled .md docs, drop the heavy extracts ──
recovered/apk-extracted/
recovered/beautified/
recovered/*.txt
