{"number":86,"name":"سُورَةُ الطَّارِقِ","ayahs":[{"n":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ وَٱلطَّارِقِ","page":591,"juz":30,"sajda":false},{"n":2,"t":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","page":591,"juz":30,"sajda":false},{"n":3,"t":"ٱلنَّجْمُ ٱلثَّاقِبُ","page":591,"juz":30,"sajda":false},{"n":4,"t":"إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ","page":591,"juz":30,"sajda":false},{"n":5,"t":"فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ","page":591,"juz":30,"sajda":false},{"n":6,"t":"خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ","page":591,"juz":30,"sajda":false},{"n":7,"t":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","page":591,"juz":30,"sajda":false},{"n":8,"t":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ","page":591,"juz":30,"sajda":false},{"n":9,"t":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","page":591,"juz":30,"sajda":false},{"n":10,"t":"فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ","page":591,"juz":30,"sajda":false},{"n":11,"t":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","page":591,"juz":30,"sajda":false},{"n":12,"t":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","page":591,"juz":30,"sajda":false},{"n":13,"t":"إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ","page":591,"juz":30,"sajda":false},{"n":14,"t":"وَمَا هُوَ بِٱلْهَزْلِ","page":591,"juz":30,"sajda":false},{"n":15,"t":"إِنَّهُمْ يَكِيدُونَ كَيْدًۭا","page":591,"juz":30,"sajda":false},{"n":16,"t":"وَأَكِيدُ كَيْدًۭا","page":591,"juz":30,"sajda":false},{"n":17,"t":"فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","page":591,"juz":30,"sajda":false}]}