{"number":70,"name":"سُورَةُ المَعَارِجِ","ayahs":[{"n":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَأَلَ سَآئِلٌۢ بِعَذَابٍۢ وَاقِعٍۢ","page":568,"juz":29,"sajda":false},{"n":2,"t":"لِّلْكَٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌۭ","page":568,"juz":29,"sajda":false},{"n":3,"t":"مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ","page":568,"juz":29,"sajda":false},{"n":4,"t":"تَعْرُجُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍۢ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍۢ","page":568,"juz":29,"sajda":false},{"n":5,"t":"فَٱصْبِرْ صَبْرًۭا جَمِيلًا","page":568,"juz":29,"sajda":false},{"n":6,"t":"إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًۭا","page":568,"juz":29,"sajda":false},{"n":7,"t":"وَنَرَىٰهُ قَرِيبًۭا","page":568,"juz":29,"sajda":false},{"n":8,"t":"يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ","page":568,"juz":29,"sajda":false},{"n":9,"t":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ","page":568,"juz":29,"sajda":false},{"n":10,"t":"وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًۭا","page":568,"juz":29,"sajda":false},{"n":11,"t":"يُبَصَّرُونَهُمْ ۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ","page":569,"juz":29,"sajda":false},{"n":12,"t":"وَصَٰحِبَتِهِۦ وَأَخِيهِ","page":569,"juz":29,"sajda":false},{"n":13,"t":"وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ","page":569,"juz":29,"sajda":false},{"n":14,"t":"وَمَن فِى ٱلْأَرْضِ جَمِيعًۭا ثُمَّ يُنجِيهِ","page":569,"juz":29,"sajda":false},{"n":15,"t":"كَلَّآ ۖ إِنَّهَا لَظَىٰ","page":569,"juz":29,"sajda":false},{"n":16,"t":"نَزَّاعَةًۭ لِّلشَّوَىٰ","page":569,"juz":29,"sajda":false},{"n":17,"t":"تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ","page":569,"juz":29,"sajda":false},{"n":18,"t":"وَجَمَعَ فَأَوْعَىٰٓ","page":569,"juz":29,"sajda":false},{"n":19,"t":"۞ إِنَّ ٱلْإِنسَٰنَ خُلِقَ هَلُوعًا","page":569,"juz":29,"sajda":false},{"n":20,"t":"إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًۭا","page":569,"juz":29,"sajda":false},{"n":21,"t":"وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا","page":569,"juz":29,"sajda":false},{"n":22,"t":"إِلَّا ٱلْمُصَلِّينَ","page":569,"juz":29,"sajda":false},{"n":23,"t":"ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ","page":569,"juz":29,"sajda":false},{"n":24,"t":"وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّۭ مَّعْلُومٌۭ","page":569,"juz":29,"sajda":false},{"n":25,"t":"لِّلسَّآئِلِ وَٱلْمَحْرُومِ","page":569,"juz":29,"sajda":false},{"n":26,"t":"وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ","page":569,"juz":29,"sajda":false},{"n":27,"t":"وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ","page":569,"juz":29,"sajda":false},{"n":28,"t":"إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍۢ","page":569,"juz":29,"sajda":false},{"n":29,"t":"وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَٰفِظُونَ","page":569,"juz":29,"sajda":false},{"n":30,"t":"إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ","page":569,"juz":29,"sajda":false},{"n":31,"t":"فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَٰٓئِكَ هُمُ ٱلْعَادُونَ","page":569,"juz":29,"sajda":false},{"n":32,"t":"وَٱلَّذِينَ هُمْ لِأَمَٰنَٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ","page":569,"juz":29,"sajda":false},{"n":33,"t":"وَٱلَّذِينَ هُم بِشَهَٰدَٰتِهِمْ قَآئِمُونَ","page":569,"juz":29,"sajda":false},{"n":34,"t":"وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ","page":569,"juz":29,"sajda":false},{"n":35,"t":"أُو۟لَٰٓئِكَ فِى جَنَّٰتٍۢ مُّكْرَمُونَ","page":569,"juz":29,"sajda":false},{"n":36,"t":"فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ","page":569,"juz":29,"sajda":false},{"n":37,"t":"عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ","page":569,"juz":29,"sajda":false},{"n":38,"t":"أَيَطْمَعُ كُلُّ ٱمْرِئٍۢ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍۢ","page":569,"juz":29,"sajda":false},{"n":39,"t":"كَلَّآ ۖ إِنَّا خَلَقْنَٰهُم مِّمَّا يَعْلَمُونَ","page":569,"juz":29,"sajda":false},{"n":40,"t":"فَلَآ أُقْسِمُ بِرَبِّ ٱلْمَشَٰرِقِ وَٱلْمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ","page":570,"juz":29,"sajda":false},{"n":41,"t":"عَلَىٰٓ أَن نُّبَدِّلَ خَيْرًۭا مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَ","page":570,"juz":29,"sajda":false},{"n":42,"t":"فَذَرْهُمْ يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ يُلَٰقُوا۟ يَوْمَهُمُ ٱلَّذِى يُوعَدُونَ","page":570,"juz":29,"sajda":false},{"n":43,"t":"يَوْمَ يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ سِرَاعًۭا كَأَنَّهُمْ إِلَىٰ نُصُبٍۢ يُوفِضُونَ","page":570,"juz":29,"sajda":false},{"n":44,"t":"خَٰشِعَةً أَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌۭ ۚ ذَٰلِكَ ٱلْيَوْمُ ٱلَّذِى كَانُوا۟ يُوعَدُونَ","page":570,"juz":29,"sajda":false}]}