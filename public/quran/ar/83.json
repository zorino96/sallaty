{"number":83,"name":"سُورَةُ المُطَفِّفِينَ","ayahs":[{"n":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّلْمُطَفِّفِينَ","page":587,"juz":30,"sajda":false},{"n":2,"t":"ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ","page":587,"juz":30,"sajda":false},{"n":3,"t":"وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ","page":587,"juz":30,"sajda":false},{"n":4,"t":"أَلَا يَظُنُّ أُو۟لَٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ","page":587,"juz":30,"sajda":false},{"n":5,"t":"لِيَوْمٍ عَظِيمٍۢ","page":587,"juz":30,"sajda":false},{"n":6,"t":"يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَٰلَمِينَ","page":587,"juz":30,"sajda":false},{"n":7,"t":"كَلَّآ إِنَّ كِتَٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍۢ","page":588,"juz":30,"sajda":false},{"n":8,"t":"وَمَآ أَدْرَىٰكَ مَا سِجِّينٌۭ","page":588,"juz":30,"sajda":false},{"n":9,"t":"كِتَٰبٌۭ مَّرْقُومٌۭ","page":588,"juz":30,"sajda":false},{"n":10,"t":"وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ","page":588,"juz":30,"sajda":false},{"n":11,"t":"ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ","page":588,"juz":30,"sajda":false},{"n":12,"t":"وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ","page":588,"juz":30,"sajda":false},{"n":13,"t":"إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ","page":588,"juz":30,"sajda":false},{"n":14,"t":"كَلَّا ۖ بَلْ ۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ","page":588,"juz":30,"sajda":false},{"n":15,"t":"كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍۢ لَّمَحْجُوبُونَ","page":588,"juz":30,"sajda":false},{"n":16,"t":"ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ","page":588,"juz":30,"sajda":false},{"n":17,"t":"ثُمَّ يُقَالُ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ","page":588,"juz":30,"sajda":false},{"n":18,"t":"كَلَّآ إِنَّ كِتَٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ","page":588,"juz":30,"sajda":false},{"n":19,"t":"وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ","page":588,"juz":30,"sajda":false},{"n":20,"t":"كِتَٰبٌۭ مَّرْقُومٌۭ","page":588,"juz":30,"sajda":false},{"n":21,"t":"يَشْهَدُهُ ٱلْمُقَرَّبُونَ","page":588,"juz":30,