{"number":84,"name":"سُورَةُ الانشِقَاقِ","ayahs":[{"n":1,"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ","page":589,"juz":30,"sajda":false},{"n":2,"t":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","page":589,"juz":30,"sajda":false},{"n":3,"t":"وَإِذَا ٱلْأَرْضُ مُدَّتْ","page":589,"juz":30,"sajda":false},{"n":4,"t":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ","page":589,"juz":30,"sajda":false},{"n":5,"t":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","page":589,"juz":30,"sajda":false},{"n":6,"t":"يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًۭا فَمُلَٰقِيهِ","page":589,"juz":30,"sajda":false},{"n":7,"t":"فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ","page":589,"juz":30,"sajda":false},{"n":8,"t":"فَسَوْفَ يُحَاسَبُ حِسَابًۭا يَسِيرًۭا","page":589,"juz":30,"sajda":false},{"n":9,"t":"وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًۭا","page":589,"juz":30,"sajda":false},{"n":10,"t":"وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ","page":589,"juz":30,"sajda":false},{"n":11,"t":"فَسَوْفَ يَدْعُوا۟ ثُبُورًۭا","page":589,"juz":30,"sajda":false},{"n":12,"t":"وَيَصْلَىٰ سَعِيرًا","page":589,"juz":30,"sajda":false},{"n":13,"t":"إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا","page":589,"juz":30,"sajda":false},{"n":14,"t":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ","page":589,"juz":30,"sajda":false},{"n":15,"t":"بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًۭا","page":589,"juz":30,"sajda":false},{"n":16,"t":"فَلَآ أُقْسِمُ بِٱلشَّفَقِ","page":589,"juz":30,"sajda":false},{"n":17,"t":"وَٱلَّيْلِ وَمَا وَسَقَ","page":589,"juz":30,"sajda":false},{"n":18,"t":"وَٱلْقَمَرِ إِذَا ٱتَّسَقَ","page":589,"juz":30,"sajda":false},{"n":19,"t":"لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍۢ","page":589,"juz":30,"sajda":false},{"n":20,"t":"فَمَا لَهُمْ لَا يُؤْمِنُونَ","page":589,"juz":30,"sajda":false},{"n":21,"t":"وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩","page":589,"juz":30,"sajda":true},{"n":22,"t":"بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ","page":589,"juz":30,"sajda":false},{"n":23,"t":"وَٱللَّهُ أَعْلَ