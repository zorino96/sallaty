{"number":95,"name":"سُورَةُ التِّينِ","ayahs":[{"n":1,"t":"بِّسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلتِّينِ وَٱلزَّيْتُونِ","page":597,"juz":30,"sajda":false},{"n":2,"t":"وَطُورِ سِينِينَ","page":597,"juz":30,"sajda":false},{"n":3,"t":"وَهَٰذَا ٱلْبَلَدِ ٱلْأَمِينِ","page":597,"juz":30,"sajda":false},{"n":4,"t":"لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍۢ","page":597,"juz":30,"sajda":false},{"n":5,"t":"ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ","page":597,"juz":30,"sajda":false},{"n":6,"t":"إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۢ","page":597,"juz":30,"sajda":false},{"n":7,"t":"فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ","page":597,"juz":30,"sajda":false},{"n":8,"t":"أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَٰكِمِينَ","page":597,"juz":30,"sajda":false}]}