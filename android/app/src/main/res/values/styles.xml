<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>

    <!-- The alarm screen, and the reason it needs a theme of its own.
         AdhanAlarmActivity extends AppCompatActivity, and AppCompat refuses to
         inflate a layout under a theme that is not one of its own. It used to be
         given AppTheme.NoActionBarLaunch, which descends from Theme.SplashScreen
         and so from android:Theme.DeviceDefault — not an AppCompat theme. Every
         time the adhan fired and the alarm screen opened, setContentView threw
         IllegalStateException straight out of onCreate. It was 99% of all crashes
         in 1.0.3: 165 people, 735 times.

         MainActivity carries that same theme and survives only because
         Capacitor's BridgeActivity calls setTheme(AppTheme_NoActionBar) before
         it inflates anything. This activity inflates immediately, so it needs the
         right theme from the manifest. -->
    <style name="AppTheme.Alarm" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Opaque, and the same ink the screen is about to paint, so waking over
             the lock screen does not flash a pale frame first. -->
        <item name="android:windowBackground">#FF0A1330</item>
    </style>
</resources>