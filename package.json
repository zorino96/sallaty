{
  "name": "sallaty",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "cap:sync": "next build && npx cap sync android",
    "cap:open": "npx cap open android",
    "android": "next build && npx cap sync android && npx cap run android",
    "apk": "node scripts/build-apk.mjs",
