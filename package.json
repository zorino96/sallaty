    "@capacitor/ios": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "adhan": "^4.4.3",
    "lucide-react": "^0.460.0",
    "next": "15.5.18",
